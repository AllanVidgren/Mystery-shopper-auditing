# --- Option A: Claude (default) ---
MS_PROVIDER=anthropic
ANTHROPIC_API_KEY=
MS_MODEL=claude-sonnet-4-5          # use a current model ID from the Anthropic console

# --- Option B: any OpenAI-compatible provider ---
# MS_PROVIDER=openai
# MS_LLM_API_KEY=                    # empty for local Ollama
# MS_BASE_URL=https://api.openai.com/v1                              # OpenAI
# MS_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai # Google Gemini
# MS_BASE_URL=https://api.mistral.ai/v1                              # Mistral (EU)
# MS_BASE_URL=https://api.groq.com/openai/v1                         # Groq
# MS_BASE_URL=https://openrouter.ai/api/v1                           # OpenRouter
# MS_BASE_URL=http://localhost:11434/v1                              # Ollama, local and free
# MS_MODEL=<model name from that provider>

MS_API_TOKEN=change-me
MS_DB=mystery_shopper.db
MS_ECONOMY=0                         # 1 = fewest AI requests (see README)
MS_DOUBLE_CHECK=1
MS_REVIEW_THRESHOLD=0.8
